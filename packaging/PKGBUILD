# Maintainer: orlfman <25542856+orlfman@users.noreply.github.com>
# Based on Arch Linux's htop PKGBUILD by Christian Hesse, T.J. Townsend and contributors.
# The patches are the amdgpu-meters commits of https://github.com/orlfman/htop,
# exported with tools/export-patches.sh (which also updates _patches and the checksums).
# Everything is installed under the htop-gpu name and it reads ~/.config/htop-gpu/htop-gpurc,
# so it sits next to the stock htop package instead of replacing it.

pkgname=htop-gpu
pkgver=3.5.3
pkgrel=12
pkgdesc='Interactive process viewer with AMD RX 9070 XT and Intel iGPU meters, alongside stock htop'
arch=('x86_64')
url='https://github.com/orlfman/htop'
license=('GPL-2.0-or-later')
depends=('libcap' 'libcap.so' 'libnl' 'ncurses' 'libncursesw.so')
makedepends=('git' 'lm_sensors')
optdepends=('lm_sensors: show cpu temperatures'
            'lsof: show files opened by a process'
            'strace: attach to a running process')
options=('!emptydirs')
validpgpkeys=('F7ABE8761E6FE68638E6283AFE0842EE36DD8C0C'  # Nathan Scott <nathans@debian.org>
              '0D316B6ABE022C7798D0324BF1D35CB9E8E12EAD') # Benny Baumann <BenBE@geshi.org>
_patches=(
  0001-linux-add-AMDGPU-sysfs-sampler-for-RX-9070-XT-meters.patch
  0002-linux-add-AMD-GPU-usage-VRAM-and-power-meters.patch
  0003-linux-add-AMD-GPU-temperature-and-clock-meters.patch
  0004-linux-add-AMD-GPU-video-engine-meter.patch
  0005-Settings-give-htop-gpu-its-own-configuration-file.patch
  0006-linux-add-AMD-GPU-fan-meter.patch
  0007-linux-add-Intel-CPU-package-power-meter.patch
  0008-linux-read-the-Intel-CPU-power-limit-on-every-refres.patch
  0009-linux-label-Intel-CPU-power-meter-Pwr.patch
  0010-linux-add-Intel-iGPU-meters.patch
)
source=("git+https://github.com/htop-dev/htop.git#tag=${pkgver}"
        "${_patches[@]}")
sha256sums=('a4619a140f8374c526d27cf5f892b2dceaee27b33a0446d902c35962a5159850'
            '6908cfdf7580fef55c8c7dfd5504e0504580cc1262614dd6863cf86e8a7b4bfb'
            '56afc12e5f2eef5a19f39ef9cfd66afdf8b5621dd54eb87a78affe2600b89dd0'
            'd236472b9607f2b50641f8e463059e8e524d7af26981e18df390846d586c329d'
            'b2db15c94057fcea21b39441e01e14d0131c761f6fbc9802fb2a57b66fc2af3c'
            '5814ba8441f3035bafe0e74311a977690b6658a5f2e1f826fb8b409605626740'
            '1d6e725d6230937525316a3009f6b4e4ee6f64aed7df0831b9a513035076dedc'
            '8902394de6621adf0080981a4a6f298403d826beccaa43caf7e31d9cd7883b2c'
            '868e4c5a2d8b758a26564866cf75cf326b73c0edbcbebd228b6d56bd082668e1'
            'b295686879307047feda3d920827d52ca51feeb33befe19240112ad6ec1cc328'
            '7d354519a93d9205d60af19d5d2a8a42b06c5da69e23f9de82a8be65aaf5953b')

prepare() {
  cd htop

  local _p
  for _p in "${_patches[@]}"; do
    patch -Np1 -i "${srcdir}/${_p}"
  done

  sed -i \
    -e "/^m4_define(\[htop_release_version\],/ c m4_define([htop_release_version], [${pkgver}-${pkgrel}-gpu])" \
    -e '/^AC_INIT/s|m4_defn(\[htop_git_version\])||' configure.ac

  autoreconf -fi
}

build() {
  cd htop

  # Arch's flags, minus --enable-openvz / --enable-vserver, which 3.5.3 no longer has.
  # libunwind is pinned off: Arch's clean chroot doesn't have it, so its htop doesn't
  # link it, but configure would pick it up from any build machine that does.
  ./configure \
      --prefix=/usr \
      --sysconfdir=/etc \
      --enable-affinity \
      --enable-capabilities \
      --enable-delayacct \
      --enable-sensors \
      --enable-unicode \
      --without-libunwind

  make
}

package() {
  cd htop

  make DESTDIR="${pkgdir}" install

  # rename everything stock htop also installs, so both packages fit side by side
  cd "${pkgdir}/usr"
  mv bin/htop bin/htop-gpu
  mv share/man/man1/htop.1 share/man/man1/htop-gpu.1
  mv share/applications/htop.desktop share/applications/htop-gpu.desktop
  mv share/icons/hicolor/scalable/apps/htop.svg share/icons/hicolor/scalable/apps/htop-gpu.svg
  mv share/pixmaps/htop.png share/pixmaps/htop-gpu.png
  sed -i \
    -e 's/^Name=Htop$/Name=htop-gpu/' \
    -e 's/^Icon=htop$/Icon=htop-gpu/' \
    -e 's/^Exec=htop$/Exec=htop-gpu/' \
    share/applications/htop-gpu.desktop

  # fail loudly if a new htop release installs a file this list doesn't know yet
  local _left
  _left=$(find . -name 'htop*' ! -name 'htop-gpu*')
  if [[ -n ${_left} ]]; then
    error "files still named like stock htop's: ${_left}"
    return 1
  fi
}
