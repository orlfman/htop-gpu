  0002-linux-add-AMD-GPU-usage-VRAM-and-power-meters.patch
  0003-linux-add-AMD-GPU-temperature-and-clock-meters.patch
  0004-linux-add-AMD-GPU-video-engine-meter.patch
  0005-Settings-give-htop-gpu-its-own-configuration-file.patch
  0006-linux-add-AMD-GPU-fan-meter.patch
  0007-linux-add-Intel-CPU-package-power-meter.patch
  0008-linux-read-the-Intel-CPU-power-limit-on-every-refres.patch
  0009-linux-label-Intel-CPU-power-meter-Pwr.patch
  0010-linux-add-Intel-iGPU-meters.patch
  0011-linux-add-AMD-GPU-heading-meter.patch
  0012-linux-add-CPU-heading-meter.patch
  0013-linux-support-RDNA-2-and-newer-AMD-dedicated-cards.patch
  0014-linux-retry-AMD-GPU-values-after-access-errors.patch
  0015-linux-read-an-AMD-card-only-when-it-is-known-to-be-a.patch
  0016-linux-extend-Intel-integrated-graphics-support.patch
  0017-linux-harden-Intel-iGPU-sampling-for-xe-and-the-GPU-.patch
)
source=("git+https://github.com/htop-dev/htop.git#tag=${pkgver}"
        "${_patches[@]}")
