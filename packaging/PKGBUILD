# Maintainer: orlfman <25542856+orlfman@users.noreply.github.com>
# Based on Arch Linux's htop PKGBUILD by Christian Hesse, T.J. Townsend and contributors.
# The patches are the amdgpu-meters commits of https://github.com/orlfman/htop,
# exported with tools/export-patches.sh (which also updates _patches and the checksums).
# Everything is installed under the htop-gpu name and it reads ~/.config/htop-gpu/htop-gpurc,
# so it sits next to the stock htop package instead of replacing it.

pkgname=htop-gpu
pkgver=3.5.3
pkgrel=16
pkgdesc='Interactive process viewer with AMD Radeon RX 6000/7000/9000 and Intel iGPU meters, alongside stock htop'
arch=('x86_64')
url='https://github.com/orlfman/htop'
license=('GPL-2.0-or-later')
depends=('libcap' 'libcap.so' 'libnl' 'ncurses' 'libncursesw.so')
makedepends=('git' 'lm_sensors')
optdepends=('libdrm: names of AMD cards in the GPU heading'
            'lm_sensors: show cpu temperatures'
            'lsof: show files opened by a process'
            'strace: attach to a running process')
options=('!emptydirs')
validpgpkeys=('F7ABE8761E6FE68638E6283AFE0842EE36DD8C0C'  # Nathan Scott <nathans@debian.org>
              '0D316B6ABE022C7798D0324BF1D35CB9E8E12EAD') # Benny Baumann <BenBE@geshi.org>
_patches=(
  0001-linux-add-AMDGPU-sysfs-sampler-for-RX-9070-XT-meters.patch
  0002-linux-add-AMD-GPU-usage-VRAM-and-power-meters.patch
  0003-linux-add-AMD-GPU-temperature-and-clock-meters.patch
  0004-linux-add-AMD-GPU-video-engine-meter.patch
  0005-Settings-give-htop-gpu-its-own-configuration-file.patch
  0006-linux-add-AMD-GPU-fan-meter.patch
  0007-linux-add-Intel-CPU-package-power-meter.patch
  0008-linux-read-the-Intel-CPU-power-limit-on-every-refres.patch
  0009-linux-label-Intel-CPU-power-meter-Pwr.patch
  0010-linux-add-Intel-iGPU-meters.patch
  0011-linux-add-AMD-GPU-heading-meter.patch
  0012-linux-add-CPU-heading-meter.patch
  0013-linux-support-RDNA-2-and-newer-AMD-dedicated-cards.patch
  0014-linux-retry-AMD-GPU-values-after-access-errors.patch
  0015-linux-read-an-AMD-card-only-when-it-is-known-to-be-a.patch
)
source=("git+https://github.com/htop-dev/htop.git#tag=${pkgver}"
        "${_patches[@]}")
sha256sums=('a4619a140f8374c526d27cf5f892b2dceaee27b33a0446d902c35962a5159850'
