prepare() {
  cd htop

  local _p
  for _p in "${_patches[@]}"; do
    patch -Np1 -i "${srcdir}/${_p}"
  done

  sed -i \
    -e "/^m4_define(\[htop_release_version\],/ c m4_define([htop_release_version], [${pkgver}-${pkgrel}-gpu])" \
    -e '/^AC_INIT/s|m4_defn(\[htop_git_version\])||' configure.ac

  autoreconf -fi
}

build() {
  cd htop

  # Arch's flags, minus --enable-openvz / --enable-vserver, which 3.5.3 no longer has.
  # libunwind is pinned off: Arch's clean chroot doesn't have it, so its htop doesn't
  # link it, but configure would pick it up from any build machine that does.
  ./configure \
      --prefix=/usr \
      --sysconfdir=/etc \
      --enable-affinity \
      --enable-capabilities \
      --enable-delayacct \
      --enable-sensors \
      --enable-unicode \
      --without-libunwind

  make
}

package() {
  cd htop

  make DESTDIR="${pkgdir}" install

  # rename everything stock htop also installs, so both packages fit side by side
  cd "${pkgdir}/usr"
  mv bin/htop bin/htop-gpu
  mv share/man/man1/htop.1 share/man/man1/htop-gpu.1
  mv share/applications/htop.desktop share/applications/htop-gpu.desktop
  mv share/icons/hicolor/scalable/apps/htop.svg share/icons/hicolor/scalable/apps/htop-gpu.svg
  mv share/pixmaps/htop.png share/pixmaps/htop-gpu.png
  sed -i \
    -e 's/^Name=Htop$/Name=htop-gpu/' \
    -e 's/^Icon=htop$/Icon=htop-gpu/' \
    -e 's/^Exec=htop$/Exec=htop-gpu/' \
    share/applications/htop-gpu.desktop

  # fail loudly if a new htop release installs a file this list doesn't know yet
  local _left
  _left=$(find . -name 'htop*' ! -name 'htop-gpu*')
  if [[ -n ${_left} ]]; then
    error "files still named like stock htop's: ${_left}"
    return 1
  fi
}
