# Maintainer: orlfman <25542856+orlfman@users.noreply.github.com>
# Based on Arch Linux's htop PKGBUILD by Christian Hesse, T.J. Townsend and contributors.
# The patches are the amdgpu-meters commits of the project's htop clone (src/htop),
# exported with tools/export-patches.sh (which also updates _patches and the checksums).
# Everything is installed under the htop-gpu name and it reads ~/.config/htop-gpu/htop-gpurc,
# so it sits next to the stock htop package instead of replacing it.

pkgname=htop-gpu
pkgver=3.5.3
pkgrel=19
pkgdesc='Interactive process viewer with AMD Radeon RX 6000/7000/9000 and Intel iGPU meters, alongside stock htop'
arch=('x86_64')
url='https://github.com/orlfman/htop-gpu'
license=('GPL-2.0-or-later')
depends=('libcap' 'libcap.so' 'libnl' 'ncurses' 'libncursesw.so')
makedepends=('git' 'lm_sensors')
optdepends=('libdrm: names of AMD cards in the GPU heading'
            'lm_sensors: show cpu temperatures'
            'lsof: show files opened by a process'
            'strace: attach to a running process')
options=('!emptydirs')
validpgpkeys=('F7ABE8761E6FE68638E6283AFE0842EE36DD8C0C'  # Nathan Scott <nathans@debian.org>
              '0D316B6ABE022C7798D0324BF1D35CB9E8E12EAD') # Benny Baumann <BenBE@geshi.org>
