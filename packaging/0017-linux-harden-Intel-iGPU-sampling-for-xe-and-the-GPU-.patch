+bool IntelGPU_isXeFd(uint64_t monotonicMs, openat_arg_t procFd, const char* fd) {
+   static uint64_t checkedMs = UINT64_MAX;
+   static struct stat xeDriver;
+   static bool haveXe;
+
+   if (checkedMs != monotonicMs) {
+      checkedMs = monotonicMs;
+      haveXe = stat(INTELGPU_SYSFS_ROOT "/bus/pci/drivers/xe", &xeDriver) == 0;
+   }
+   if (!haveXe)
+      return false;
+
+   char path[1024];
+   dev_t rdev;
+#ifdef HAVE_OPENAT
+   int linkDir = procFd;
+   xSnprintf(path, sizeof(path), "fd/%s", fd);
+#else
+   int linkDir = AT_FDCWD;
+   xSnprintf(path, sizeof(path), "%s/fd/%s", procFd, fd);
+#endif
+   /* An unclassified descriptor could only be identified through its fdinfo, which is the very
+    * read that wakes xe. It is not skipped, so GPU% keeps upstream behavior for it. */
+   if (IntelGPU_fdDevice(linkDir, path, &rdev, monotonicMs) != INTELGPU_FD_DEVICE)
+      return false;
+
+   /* Follow the node's current driver binding. Card and render minors can be reused. */
+   struct stat st;
+   xSnprintf(path, sizeof(path), INTELGPU_SYSFS_ROOT "/dev/char/%u:%u/device/driver", major(rdev), minor(rdev));
+   return stat(path, &st) == 0 && st.st_dev == xeDriver.st_dev && st.st_ino == xeDriver.st_ino;
+}
+
+static uint64_t IntelGPU_nowMs(void) {
+   struct timespec ts;
+   if (clock_gettime(CLOCK_MONOTONIC, &ts) != 0)
+      return 0;
+   return (uint64_t)ts.tv_sec * 1000 + (uint64_t)ts.tv_nsec / 1000000;
+}
+
+static bool IntelGPU_xeReadDue(void) {
+   char buffer[64];
+   if (IntelGPU_readText(device.dir, "power/control", buffer, sizeof(buffer)) && String_eq(buffer, "on"))
+      return true;
+
+   long delay = 1000;
+   if (IntelGPU_readText(device.dir, "power/autosuspend_delay_ms", buffer, sizeof(buffer))) {
+      char* end;
+      errno = 0;
+      long configured = strtol(buffer, &end, 10);
+      if (!errno && end != buffer && !*end)
+         delay = configured;
+   }
+   if (delay <= 0)
+      return true;
+
+   /* Runtime PM allows 25% timer slack. Give suspend another 50 ms before a read can mark the GPU busy. */
+   const uint64_t pmSlackMs = (uint64_t)delay / 4 + 50;
+   uint64_t now = IntelGPU_nowMs();
+   return !lastXeReadMs || now < lastXeReadMs || now - lastXeReadMs >= (uint64_t)delay + pmSlackMs;
+}
