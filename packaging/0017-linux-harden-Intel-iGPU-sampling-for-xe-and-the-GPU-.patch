+static ssize_t IntelGPU_readlink(int dir, const char* path, char* buffer, size_t size) {
+#ifdef HAVE_READLINKAT
+   return readlinkat(dir, path, buffer, size);
+#else
+   char full[4096];
+   return readlink(IntelGPU_atPath(dir, path, full, sizeof(full)), buffer, size);
+#endif
