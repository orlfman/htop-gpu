+/* Without the *at calls, reach the link through its directory's /proc/self/fd entry. */
+ATTR_UNUSED
+static const char* IntelGPU_atPath(int dir, const char* path, char* buffer, size_t size) {
+   if (dir == AT_FDCWD)
+      return path;
+   xSnprintf(buffer, size, "/proc/self/fd/%d/%s", dir, path);
+   return buffer;
+}
