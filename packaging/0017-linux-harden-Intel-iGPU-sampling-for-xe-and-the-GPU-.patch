+#if defined(SYS_statx) && defined(STATX_TYPE) && defined(AT_STATX_DONT_SYNC)
+#define INTELGPU_HAVE_STATX
+#endif
+
+static bool IntelGPU_lookupDevice(int dir, const char* path, dev_t* rdev) {
+#ifdef INTELGPU_HAVE_STATX
+   /* The raw system call needs no libc wrapper. It asks for cached attributes only, as an
+    * extra guard for paths from other mount namespaces. Where the kernel or a seccomp policy
+    * rejects it, stat is used from then on instead of losing the client. */
+   static bool statxMissing;
+   if (!statxMissing) {
+      struct statx stx;
+      if (syscall(SYS_statx, (long)dir, path, (long)AT_STATX_DONT_SYNC, (long)STATX_TYPE, &stx) == 0) {
+         if (!(stx.stx_mask & STATX_TYPE) || !S_ISCHR(stx.stx_mode))
+            return false;
+         *rdev = makedev(stx.stx_rdev_major, stx.stx_rdev_minor);
+         return true;
+      }
+      if (errno != ENOSYS && errno != EPERM)
+         return false;
+      statxMissing = true;
+   }
+#endif
+
+   struct stat st;
+#ifdef HAVE_FSTATAT
+   int ret = fstatat(dir, path, &st, 0);
+#else
+   char full[4096];
+   int ret = stat(IntelGPU_atPath(dir, path, full, sizeof(full)), &st);
+#endif
+   if (ret != 0 || !S_ISCHR(st.st_mode))
+      return false;
+   *rdev = st.st_rdev;
+   return true;
+}
+
+typedef enum IntelGPUFdKind_ {
+   INTELGPU_FD_OTHER,        /* not a device, or the descriptor went away */
+   INTELGPU_FD_DENIED,       /* the link or its target could not be read */
+   INTELGPU_FD_DEVICE,       /* a character device, *rdev is set */
+   INTELGPU_FD_UNCLASSIFIED, /* a path that is never looked up, identified by fdinfo instead */
+} IntelGPUFdKind;
+
+/* Classify a /proc fd link without asking a network or FUSE filesystem, which can block on
+ * a hung NFS, SMB or FUSE mount. Link texts that are not paths (sockets, pipes, anonymous
+ * inodes) are never devices. DRM nodes are looked up directly, other paths only when they
+ * resolve to a local filesystem. Everything else is unclassified: fdinfo only reports the
+ * kernel's own bookkeeping, so the Intel sampler can identify such a client from it. */
+static IntelGPUFdKind IntelGPU_fdDevice(int dir, const char* path, dev_t* rdev, uint64_t monotonicMs) {
+   char target[4096];
+   ssize_t n = IntelGPU_readlink(dir, path, target, sizeof(target) - 1);
+   if (n < 0)
+      return errno == EACCES || errno == EPERM ? INTELGPU_FD_DENIED : INTELGPU_FD_OTHER;
+   if ((size_t)n >= sizeof(target) - 1)
+      return INTELGPU_FD_UNCLASSIFIED;
+
+   target[n] = '\0';
+   if (target[0] != '/')
+      return INTELGPU_FD_OTHER;
+   bool lookUp = String_startsWith(target, INTELGPU_DRM_PREFIX) || IntelGPU_localPath(target, monotonicMs);
+   if (!lookUp)
+      return INTELGPU_FD_UNCLASSIFIED;
+
+   errno = 0;
+   if (!IntelGPU_lookupDevice(dir, path, rdev))
+      return errno == EACCES || errno == EPERM ? INTELGPU_FD_DENIED : INTELGPU_FD_OTHER;
+   return INTELGPU_FD_DEVICE;
+}
