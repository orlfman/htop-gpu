+/* Filesystems that answer attribute lookups without a server or daemon. Every other type,
+ * including network filesystems missing from this list, is never looked up. */
+static bool IntelGPU_localType(const char* type) {
+   static const char* const local[] = {
+      "devtmpfs", "tmpfs", "ramfs", "ext2", "ext3", "ext4", "xfs", "btrfs", "f2fs",
+      "bcachefs", "zfs", "jfs", "nilfs2", "vfat", "exfat", "ntfs3",
+   };
+   for (size_t i = 0; i < ARRAYSIZE(local); i++)
+      if (String_eq(type, local[i]))
+         return true;
+   return false;
+}
+
+/* mountinfo escapes space, tab, newline and backslash as three octal digits. */
+static void IntelGPU_unescape(char* text) {
+   char* out = text;
+   const char* in = text;
+   while (*in) {
+      if (in[0] == '\\' && in[1] >= '0' && in[1] <= '3' && in[2] >= '0' && in[2] <= '7' && in[3] >= '0' && in[3] <= '7') {
+         *out++ = (char)((in[1] - '0') * 64 + (in[2] - '0') * 8 + (in[3] - '0'));
+         in += 4;
+      } else {
+         *out++ = *in++;
+      }
+   }
+   *out = '\0';
+}
+
+static bool IntelGPU_mountId(const char* text, unsigned long* id) {
+   char* end;
+   errno = 0;
+   *id = strtoul(text, &end, 10);
+   return !errno && end != text && !*end;
+}
+
+/* One parse per refresh, shared by the Intel meters and the GPU% column. */
+static void IntelGPU_loadMounts(uint64_t monotonicMs) {
+   if (mountsMs == monotonicMs)
+      return;
+
+   mountsMs = monotonicMs;
+   for (size_t i = 0; i < mountCount; i++)
+      free(mounts[i].path);
+   mountCount = 0;
+   mountRoot = SIZE_MAX;
+
+   FILE* file = fopen(INTELGPU_PROC_ROOT "/self/mountinfo", "r");
+   if (!file)
+      return;
+
+   char* line = NULL;
+   size_t size = 0;
+   while (getline(&line, &size, file) > 0) {
+      /* id parent major:minor root mountpoint options [optional fields] - type source superoptions */
+      char* fields[5] = {0};
+      char* cursor = line;
+      for (size_t i = 0; i < ARRAYSIZE(fields) && cursor; i++)
+         fields[i] = strsep(&cursor, " ");
+      char* separator = cursor ? strstr(cursor, " - ") : NULL;
+      unsigned long id, parent;
+      if (!fields[4] || !separator || !IntelGPU_mountId(fields[0], &id) || !IntelGPU_mountId(fields[1], &parent))
+         continue;
+
+      char* type = separator + 3;
+      type[strcspn(type, " \n")] = '\0';
+      IntelGPU_unescape(fields[4]);
+      if (mountCount == mountCapacity) {
+         mountCapacity = mountCapacity ? mountCapacity * 2 : 32;
+         mounts = xReallocArray(mounts, mountCapacity, sizeof(*mounts));
+      }
+      mounts[mountCount++] = (IntelGPUMount) {
+         .id = id, .parent = parent, .path = xStrdup(fields[4]), .length = strlen(fields[4]),
+         .local = IntelGPU_localType(type),
+      };
+   }
+   free(line);
+   fclose(file);
+
+   /* The root of the walk: the first "/" mount whose parent is not in this table. */
+   for (size_t i = 0; i < mountCount && mountRoot == SIZE_MAX; i++) {
+      if (!String_eq(mounts[i].path, "/"))
+         continue;
+      bool covered = false;
+      for (size_t j = 0; j < mountCount && !covered; j++)
+         covered = j != i && mounts[j].id == mounts[i].parent;
+      if (!covered)
+         mountRoot = i;
+   }
+}
+
+/* The last candidate with this parent at this mount point. A mount stacked on the same place
+ * has the covered mount as its parent and comes later in the table. */
+static const IntelGPUMount* IntelGPU_childAt(unsigned long parent, const char* path) {
+   const IntelGPUMount* found = NULL;
+   for (size_t i = 0; i < candidateCount; i++) {
+      const IntelGPUMount* mount = &mounts[candidates[i]];
+      if (mount->parent == parent && mount->id != parent && String_eq(mount->path, path))
+         found = mount;
+   }
+   return found;
+}
+
+/* Follow mounts stacked on the same place up to the visible one. */
+static const IntelGPUMount* IntelGPU_topmost(const IntelGPUMount* mount) {
+   for (size_t guard = 0; guard < mountCount; guard++) {
+      const IntelGPUMount* above = IntelGPU_childAt(mount->id, mount->path);
+      if (!above)
+         break;
+      mount = above;
+   }
+   return mount;
+}
+
+/* Resolve the mount holding a path the way a path walk does: start at the visible root mount,
+ * then enter the visible child mounted at each leading directory. Mounts hidden under a later
+ * mount are never reached. The link text is a path in this process's mount namespace, so this
+ * process's table is used. An unreadable or unresolvable table counts as not local. */
+static bool IntelGPU_localPath(const char* path, uint64_t monotonicMs) {
+   IntelGPU_loadMounts(monotonicMs);
+   if (mountRoot == SIZE_MAX)
       return false;
+
+   /* Only mounts at the path itself or at one of its leading directories can hold it.
+    * One pass collects them, so the walk below never rescans the whole table. */
+   candidateCount = 0;
+   for (size_t i = 0; i < mountCount; i++) {
+      const IntelGPUMount* mount = &mounts[i];
+      bool root = mount->length == 1 && mount->path[0] == '/';
+      if (strncmp(path, mount->path, mount->length) != 0 ||
+            (!root && path[mount->length] != '\0' && path[mount->length] != '/'))
+         continue;
+      if (candidateCount == candidateCapacity) {
+         candidateCapacity = candidateCapacity ? candidateCapacity * 2 : 16;
+         candidates = xReallocArray(candidates, candidateCapacity, sizeof(*candidates));
+      }
+      candidates[candidateCount++] = i;
    }
-   if (!S_ISCHR(st.st_mode))
+
+   const IntelGPUMount* mount = IntelGPU_topmost(&mounts[mountRoot]);
+   char prefix[4096];
+   size_t length = strlen(path);
+   if (length >= sizeof(prefix))
       return false;
+
+   for (size_t i = 1; i <= length; i++) {
+      if (i < length && path[i] != '/')
+         continue;
+      memcpy(prefix, path, i);
+      prefix[i] = '\0';
+      const IntelGPUMount* child = IntelGPU_childAt(mount->id, prefix);
+      if (child)
+         mount = IntelGPU_topmost(child);
+   }
+   return mount->local;
+}
