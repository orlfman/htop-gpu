--- /dev/null
+++ b/linux/MeterClock.h
@@ -0,0 +1,37 @@
+#ifndef HEADER_MeterClock
+#define HEADER_MeterClock
+/*
+htop - linux/MeterClock.h
+(C) 2026 orlfman
+Released under the GNU GPLv2+, see the COPYING file
+in the source distribution for its full text.
+*/
+
+#include <stdint.h>
+
+#include "Machine.h"
+#include "linux/Platform.h"
+
+
+/* The timestamp a header meter hands its sampler. htop stops advancing monotonicMs while the
+   process list is paused (Z) but keeps updating the header, so during a pause the clock is read
+   once per header pass instead. Otherwise it is monotonicMs itself, which keeps caches keyed to
+   it, like the Intel mount table shared with the GPU% column, to one per refresh. Each file that
+   includes this keeps its own state; the clock and the values are the same. */
+static inline uint64_t MeterClock_now(const Machine* host) {
+   static uint64_t pass = UINT64_MAX;
+   static uint64_t lastMonotonicMs;
+   static uint64_t now;
+   if (host->realtimeMs != pass) {
+      pass = host->realtimeMs;
+      if (host->monotonicMs != lastMonotonicMs) {
+         lastMonotonicMs = host->monotonicMs;
+         now = host->monotonicMs;
+      } else {
+         Platform_gettime_monotonic(&now);
+      }
+   }
+   return now;
+}
+
+#endif /* HEADER_MeterClock */
