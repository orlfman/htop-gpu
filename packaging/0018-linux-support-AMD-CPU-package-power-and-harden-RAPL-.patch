+typedef struct IntelRAPLReading_ {
+   double energy;
+   double limit;
+   bool denied;
+} IntelRAPLReading;
+
+/* Use one directory handle for the name, identity and counters. A reused path might
+   identify a different package, so ask the caller to rediscover the topology. */
+static bool IntelRAPL_readZone(IntelRAPLZone* zone, IntelRAPLReading* reading) {
+   for (int s = 0; s < INTELRAPL_SOURCES; s++) {
+      if (!zone->dir[s][0])
+         continue;
+      int fd = open(zone->dir[s], O_RDONLY | O_DIRECTORY | O_CLOEXEC);
+      if (fd < 0) {
+         reading->denied |= errno == EACCES || errno == EPERM;
+         continue;
+      }
 
-   IntelRAPL_readLimits();
+      char name[32];
+      if (!IntelRAPL_readText(fd, "name", name, sizeof(name))) {
+         close(fd);
+         continue;
+      }
+      if (!String_eq(name, zone->name)) {
+         close(fd);
+         return false;
+      }
 
+      /* Prefer the MSR limit even when energy has to come from MMIO. */
+      if (!isPositive(reading->limit))
+         reading->limit = IntelRAPL_readLimit(fd);
+
+      struct stat st;
+      if (isNaN(reading->energy) && fstat(fd, &st) == 0) {
+         int error;
+         double energy = IntelRAPL_readNumber(fd, "energy_uj", &error);
+         if (!isNaN(energy)) {
+            if (s != zone->source || st.st_dev != zone->device || st.st_ino != zone->inode) {
+               zone->source = s;
+               zone->device = st.st_dev;
+               zone->inode = st.st_ino;
+               zone->energy = NAN;
+               zone->range = NAN;
+            }
+            if (!isPositive(zone->range))
+               zone->range = IntelRAPL_readNumber(fd, "max_energy_range_uj", NULL);
+            reading->energy = energy;
+         } else if (error == EACCES || error == EPERM) {
+            reading->denied = true;
+         }
+      }
+      close(fd);
+      if (!isNaN(reading->energy) && isPositive(reading->limit))
+         break;
+   }
+   return true;
+}
+
+static bool IntelRAPL_sampleZones(uint64_t monotonicMs) {
    double elapsed = (double)(monotonicMs - energyMonotonicMs) / 1000.0;
    double power = 0.0;
+   double limit = 0.0;
+   bool denied = false;
    for (size_t i = 0; i < zoneCount; i++) {
       IntelRAPLZone* zone = &zones[i];
-      int error;
-      double energy = IntelRAPL_readNumber(zone->dir, "energy_uj", &error);
-
-      if (isNaN(energy) && (error == EACCES || error == EPERM)) {
-         /* root only unless made readable; the next readable counters start over */
-         for (size_t j = 0; j < zoneCount; j++)
-            zones[j].energy = NAN;
-         sample.status = INTELRAPL_NO_ACCESS;
-         sample.power = NAN;
-         return;
-      }
-      if (isNaN(energy)) {
-         /* gone or broken: forget the zones, the next refresh looks for them again */
-         IntelRAPL_forget();
-         return;
+      IntelRAPLReading reading = { .energy = NAN, .limit = NAN };
+      if (!IntelRAPL_readZone(zone, &reading))
+         return false;
+      limit += isPositive(reading.limit) ? reading.limit : NAN;
+      if (isNaN(reading.energy)) {
+         if (!reading.denied) {
+            IntelRAPL_forget();
+            return true;
+         }
+         denied = true;
+         continue;
       }
 
       /* the counter wraps around to 0 after max_energy_range_uj */
       if (isNaN(zone->energy) || !(elapsed > 0.0))
          power = NAN;
-      else if (energy >= zone->energy)
-         power += (energy - zone->energy) / 1000000.0 / elapsed;
+      else if (reading.energy >= zone->energy)
+         power += (reading.energy - zone->energy) / 1000000.0 / elapsed;
+      else if (isPositive(zone->range) && zone->range >= zone->energy)
+         power += (reading.energy + zone->range - zone->energy) / 1000000.0 / elapsed;
       else
-         power += (energy + zone->range - zone->energy) / 1000000.0 / elapsed;
+         power = NAN;
 
-      zone->energy = energy;
+      zone->energy = reading.energy;
    }
 
+   sample.powerLimit = limit;
+   if (denied) {
+      /* An aggregate needs a readable counter for every package. */
+      for (size_t i = 0; i < zoneCount; i++)
+         zones[i].energy = NAN;
+      sample.status = INTELRAPL_NO_ACCESS;
+      sample.power = NAN;
+      return true;
+   }
    sample.status = INTELRAPL_ACTIVE;
    sample.power = power;
    energyMonotonicMs = monotonicMs;
+   return true;
+}
+
+static void IntelRAPL_refresh(uint64_t monotonicMs) {
+   if (!zoneCount)
+      IntelRAPL_findZones();
+   if (!zoneCount || IntelRAPL_sampleZones(monotonicMs))
+      return;
+
+   /* Discard partial totals and baselines before regrouping. Retry at most once. */
+   IntelRAPL_findZones();
+   if (zoneCount && !IntelRAPL_sampleZones(monotonicMs))
+      IntelRAPL_forget();
 }
 
