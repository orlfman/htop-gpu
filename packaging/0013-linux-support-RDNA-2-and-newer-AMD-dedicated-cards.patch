 }
 
-static void AMDGPU_readMetrics(void) {
+static void AMDGPU_readMetrics(bool vcnBusy) {
    unsigned char metrics[512];
    if (AMDGPU_readFile(deviceDir, "gpu_metrics", metrics, sizeof(metrics)) < GPU_METRICS_V1_3_SIZE)
       return;
@@ -225,8 +356,10 @@ static void AMDGPU_readMetrics(void) {
    if (size != GPU_METRICS_V1_3_SIZE || metrics[2] != 1 || metrics[3] != 3)
       return;
 
-   sample.vclk = AMDGPU_metricsClock(metrics, GPU_METRICS_V1_3_CURRENT_VCLK0);
-   sample.dclk = AMDGPU_metricsClock(metrics, GPU_METRICS_V1_3_CURRENT_DCLK0);
+   sample.vclk = AMDGPU_metricsValue(metrics, GPU_METRICS_V1_3_CURRENT_VCLK0);
+   sample.dclk = AMDGPU_metricsValue(metrics, GPU_METRICS_V1_3_CURRENT_DCLK0);
+   if (vcnBusy)
