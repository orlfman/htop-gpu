       return NAN;
+   }
 
    double max = NAN;
    const char* line = buffer;
@@ -205,16 +334,18 @@ static double AMDGPU_readMclkMax(void) {
 
       line = newline + 1;
    }
+   if (isNaN(max))
+      staticFailed = true;
    return max;
 }
 
-static double AMDGPU_metricsClock(const unsigned char* metrics, size_t offset) {
+static double AMDGPU_metricsValue(const unsigned char* metrics, size_t offset) {
    uint16_t value;
    memcpy(&value, metrics + offset, sizeof(value));
