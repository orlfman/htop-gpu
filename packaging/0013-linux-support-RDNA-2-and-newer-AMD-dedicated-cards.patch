@@ -260,6 +393,7 @@ static void AMDGPU_forget(void) {
       sample.tempCrit[i] = NAN;
 
    staticRead = false;
+   absentTries = 0;
    hwmonDir[0] = '\0';
 }
 
@@ -277,9 +411,10 @@ static void AMDGPU_init(void) {
    sample.sclkPeak = sample.card->sclkSeed;
 }
 
-/* The values read once only count as read when all of them are there; a failed one is tried again */
+/* The values read once count as read when all of them are there. A failed one is tried again on
+   every refresh, one that is absent (a card without a fan, say) only for AMDGPU_ABSENT_TRIES refreshes. */
 static bool AMDGPU_staticComplete(void) {
-   if (isNaN(sample.vramTotal) || isNaN(sample.mclkMax) || isNaN(sample.fanMax) || !sclkIndex || !mclkIndex)
+   if (isNaN(sample.vramTotal) || isNaN(sample.sclkPeak) || isNaN(sample.mclkMax) || isNaN(sample.fanMax) || !sclkIndex || !mclkIndex)
