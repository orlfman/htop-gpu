diff --git a/linux/AMDGPU.h b/linux/AMDGPU.h
index 925c575e..c9be6eb2 100644
--- a/linux/AMDGPU.h
+++ b/linux/AMDGPU.h
@@ -27,7 +27,7 @@ typedef struct AMDGPUCard_ {
    uint16_t deviceId;
    const char* name;                 /* shown by the heading meter */
    unsigned int memRateMultiplier;   /* memory clock to data rate per pin (GDDR6: 16) */
-   double sclkSeed;                  /* MHz, initial maximum of the GPU clock bar */
+   double sclkSeed;                  /* MHz, initial maximum of the GPU clock bar; NAN: the top pp_dpm_sclk level */
 } AMDGPUCard;
 
 /* Every value is NAN when it is not available */
@@ -50,7 +50,7 @@ typedef struct AMDGPUSample_ {
    double tempCrit[AMDGPU_TEMP_COUNT];    /* degree Celsius */
 
    double sclk;                           /* MHz */
-   double sclkPeak;                       /* MHz, highest seen, at least card->sclkSeed */
+   double sclkPeak;                       /* MHz, highest seen, at least card->sclkSeed or the top pp_dpm_sclk level */
    double mclk;                           /* MHz */
    double mclkMax;                        /* MHz, top pp_dpm_mclk level */
    double memRate;                        /* Gbps per pin */
