From 6c06d2433fda370f666f286d0715c8ce0dd32534 Mon Sep 17 00:00:00 2001
From: orlfman <25542856+orlfman@users.noreply.github.com>
Date: Wed, 28 Oct 2026 18:20:54 -0700
Subject: [PATCH 8/9] linux: read the Intel CPU power limit on every refresh

The long term power limit (PL1, constraint_N_power_limit_uw) is a
writable setting, so it can change while htop runs. It was read until it
succeeded and then kept for the session, which left the meter's limit,
bar and graph scaled to the old value. It is now read on every refresh;
a limit that cannot be read shows as unavailable instead of keeping the
previous value. The energy counter range does not change and is still
cached once it reads.

Found and fixed by Codex (AUDIT.md finding 6).

Co-Authored-By: OpenAI Codex <noreply@openai.com>
Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 linux/IntelRAPL.c | 16 +++++-----------
 1 file changed, 5 insertions(+), 11 deletions(-)

diff --git a/linux/IntelRAPL.c b/linux/IntelRAPL.c
index cf70d605..def18fcf 100644
--- a/linux/IntelRAPL.c
+++ b/linux/IntelRAPL.c
@@ -41,7 +41,6 @@ typedef struct IntelRAPLZone_ {
 
 static IntelRAPLZone zones[INTELRAPL_MAX_PACKAGES];
 static size_t zoneCount;
-static bool limitsRead;
 static bool initialized;
 static uint64_t lastMonotonicMs;
 static uint64_t energyMonotonicMs;
@@ -83,7 +82,6 @@ static bool IntelRAPL_readText(const char* dir, const char* file, char* buffer,
 /* Back to "no counters": everything found about them is dropped */
 static void IntelRAPL_forget(void) {
    zoneCount = 0;
-   limitsRead = false;
    sample.status = INTELRAPL_NOT_FOUND;
    sample.packages = 0;
    sample.power = NAN;
@@ -124,14 +122,14 @@ static void IntelRAPL_findZones(void) {
       sample.status = INTELRAPL_ACTIVE;
 }
 
-/* The counter range and the long term limit do not change; they only count as read when all are there */
-static bool IntelRAPL_readLimits(void) {
-   bool complete = true;
+/* Cache the static counter range once readable; power limits can change between refreshes. */
+static void IntelRAPL_readLimits(void) {
    double total = 0.0;
 
    for (size_t i = 0; i < zoneCount; i++) {
       IntelRAPLZone* zone = &zones[i];
-      zone->range = IntelRAPL_readNumber(zone->dir, "max_energy_range_uj", NULL);
+      if (isNaN(zone->range))
+         zone->range = IntelRAPL_readNumber(zone->dir, "max_energy_range_uj", NULL);
       zone->limit = NAN;
 
       for (unsigned int c = 0; c < INTELRAPL_MAX_CONSTRAINTS; c++) {
@@ -146,13 +144,10 @@ static bool IntelRAPL_readLimits(void) {
          break;
       }
 
-      if (isNaN(zone->range) || isNaN(zone->limit))
-         complete = false;
       total += zone->limit;
    }
 
    sample.powerLimit = total;
-   return complete;
 }
 
 static void IntelRAPL_refresh(uint64_t monotonicMs) {
@@ -163,8 +158,7 @@ static void IntelRAPL_refresh(uint64_t monotonicMs) {
          return;
    }
 
-   if (!limitsRead)
-      limitsRead = IntelRAPL_readLimits();
+   IntelRAPL_readLimits();
 
    double elapsed = (double)(monotonicMs - energyMonotonicMs) / 1000.0;
    double power = 0.0;
