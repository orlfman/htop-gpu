+/* Zero means no confirmed graphics engine inventory. */
+static unsigned int IntelGPU_graphicsEngines(const char* path, bool xe) {
+   DIR* dir = opendir(path);
+   if (!dir)
+      return 0;
+   unsigned int engines = 0;
+   const struct dirent* entry;
+   errno = 0;
+   while ((entry = readdir(dir))) {
+      const char* name = entry->d_name;
+      if (String_startsWith(name, "rcs") && (xe ? !name[3] : IntelGPU_digits(name + 3)))
+         engines |= 1U << INTELGPU_RENDER;
+      if (String_startsWith(name, "ccs") && (xe ? !name[3] : IntelGPU_digits(name + 3)))
+         engines |= 1U << INTELGPU_COMPUTE;
+   }
+   bool valid = errno == 0;
+   closedir(dir);
+   return valid ? engines : 0;
+}
+
+static void IntelGPU_readTopology(void) {
+   char path[2048];
+   if (!device.xe) {
+      xSnprintf(path, sizeof(path), "%s/engine", device.card);
+      device.graphicsEngines = IntelGPU_graphicsEngines(path, false);
+      xSnprintf(path, sizeof(path), "%s/gt/gt0", device.card);
+      struct stat st;
+      if (stat(path, &st) < 0 && errno == ENOENT) {
+         sample.clock = IntelGPU_readNumber(device.card, "gt_cur_freq_mhz", 10);
+         sample.clockMax = IntelGPU_readNumber(device.card, "gt_max_freq_mhz", 10);
+      } else {
+         sample.clock = IntelGPU_readNumber(path, "rps_cur_freq_mhz", 10);
+         sample.clockMax = IntelGPU_readNumber(path, "rps_max_freq_mhz", 10);
+      }
+      return;
+   }
+
+   /* Client iGPUs have one tile. Locate its graphics GT by render or compute engines. */
+   xSnprintf(path, sizeof(path), "%s/tile0", device.dir);
+   DIR* tile = opendir(path);
+   if (!tile)
+      return;
+   const struct dirent* entry;
+   while ((entry = readdir(tile))) {
+      const char* name = entry->d_name;
+      if (!String_startsWith(name, "gt") || !IntelGPU_digits(name + 2))
+         continue;
+      xSnprintf(path, sizeof(path), "%s/tile0/%s/engines", device.dir, name);
+      device.graphicsEngines = IntelGPU_graphicsEngines(path, true);
+      if (!device.graphicsEngines)
+         continue;
+      xSnprintf(path, sizeof(path), "%s/tile0/%s/freq0", device.dir, name);
+      sample.clock = IntelGPU_readNumber(path, "cur_freq", 10);
+      sample.clockMax = IntelGPU_readNumber(path, "max_freq", 10);
+      break;
+   }
+   closedir(tile);
+}
