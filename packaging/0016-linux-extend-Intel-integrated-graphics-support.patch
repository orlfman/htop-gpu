+/* Integrated client graphics IDs from Linux 7.3 include/drm/intel/pciids.h. */
+static bool IntelGPU_supported(uint64_t product) {
+   static const uint16_t ids[] = {
+      /* Tiger Lake GT1 and GT2 */
+      0x9a60, 0x9a68, 0x9a70, 0x9a40, 0x9a49, 0x9a59, 0x9a78, 0x9ac0,
+      0x9ac9, 0x9ad9, 0x9af8,
+      /* Rocket Lake */
+      0x4c80, 0x4c8a, 0x4c8b, 0x4c8c, 0x4c90, 0x4c9a,
+      /* Alder Lake */
+      0x4680, 0x4682, 0x4688, 0x468a, 0x468b, 0x4690, 0x4692, 0x4693,
+      0x46a0, 0x46a1, 0x46a2, 0x46a3, 0x46a6, 0x46a8, 0x46aa, 0x462a,
+      0x4626, 0x4628, 0x46b0, 0x46b1, 0x46b2, 0x46b3, 0x46c0, 0x46c1,
+      0x46c2, 0x46c3, 0x46d0, 0x46d1, 0x46d2, 0x46d3, 0x46d4,
+      /* Raptor Lake and refresh */
+      0xa780, 0xa781, 0xa782, 0xa783, 0xa788, 0xa789, 0xa78a, 0xa78b,
+      0xa721, 0xa7a1, 0xa7a9, 0xa7ac, 0xa7ad, 0xa720, 0xa7a0, 0xa7a8,
+      0xa7aa, 0xa7ab,
+      /* Meteor Lake */
+      0x7d40, 0x7d45, 0x7d55, 0x7d60, 0x7dd5,
+      /* Arrow Lake */
+      0x7d51, 0x7dd1, 0x7d41, 0x7d67, 0xb640,
+      /* Lunar Lake */
+      0x6420, 0x64a0, 0x64b0,
+      /* Panther Lake and Wildcat Lake */
+      0xb080, 0xb081, 0xb082, 0xb083, 0xb084, 0xb085, 0xb086, 0xb087,
+      0xb08f, 0xb090, 0xb0a0, 0xb0b0, 0xfd80, 0xfd81,
+      /* Nova Lake */
+      0xd740, 0xd741, 0xd742, 0xd743, 0xd745, 0xd74a, 0xd74b, 0xd750,
+      0xd751, 0xd752, 0xd753, 0xd754, 0xd755, 0xd756, 0xd757, 0xd75f,
+   };
+   for (size_t i = 0; i < ARRAYSIZE(ids); i++)
+      if (product == ids[i])
+         return true;
+   return false;
+}
